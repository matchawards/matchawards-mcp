{
  "name": "@matchawards/openclaw-plugin",
  "version": "1.0.4",
  "description": "OpenClaw plugin for MatchAwards: search US government contracts, grants and jobs, see who won similar work, and size up an opportunity before you bid, through the hosted MatchAwards MCP server. Read-only, no account.",
  "license": "MIT",
  "author": {
    "name": "MatchAwards",
    "url": "https://matchawards.com"
  },
  "homepage": "https://github.com/matchawards/matchawards-mcp/tree/main/integrations/openclaw-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matchawards/matchawards-mcp.git",
    "directory": "integrations/openclaw-plugin"
  },
  "bugs": {
    "url": "https://github.com/matchawards/matchawards-mcp/issues"
  },
  "keywords": [
    "openclaw",
    "matchawards",
    "government-contracts",
    "grants",
    "rfp",
    "procurement",
    "naics"
  ],
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "tools.json",
    "openclaw.plugin.json"
  ],
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "openclaw": "2026.9.6",
    "typebox": "1.3.3",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.31.0"
  }
}
